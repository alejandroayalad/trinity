# PROPOSED EC2 configuration. Empty values are intentional startup blockers.
# Copy to /etc/trinity/.env ONLY after approval; root:root mode 0600.
# Use literal one-line values. Single-quote JSON and values containing $ or #.
# Never reuse this deployment UUID for another deployment.
COMPOSE_PROJECT_NAME=trinity-ec2
TRINITY_RELEASE=local
TRINITY_SITE_ADDRESS=http://:80
TRINITY_HTTP_BIND=127.0.0.1:8080
TRINITY_HTTPS_BIND=127.0.0.1:8443

# Fresh database password; existing EIA key supplied privately after approval.
TRINITY_POSTGRES_PASSWORD=
EIA_API_KEY=

# Existing development namespace, proposed for this challenge deployment.
TRINITY_S3_BUCKET=trinity-alayala-dev-01
TRINITY_S3_PREFIX=private/candidates
TRINITY_S3_REGION=us-east-1
TRINITY_WORKER_HOSTNAME=trinity-ec2-worker

# IAM profiles, not a credentials directory copied from a laptop.
TRINITY_QUERY_AWS_DIRECTORY=/etc/trinity/aws
TRINITY_QUERY_READ_PROFILE=trinity-reader
TRINITY_DOCKER_SOCKET_HOST=/var/run/docker.sock
TRINITY_DOCKER_GID=993
TRINITY_QUERY_STAGE_VOLUME=trinity_ec2_query_stage
TRINITY_QUERY_DEPLOYMENT_ID=2ea64c0f-3e1a-49f0-95d8-caa5e1e06580
# Set to the inspected linux/amd64 query image ID on EC2 (sha256:64hex).
# The existing local query image is linux/arm64 and cannot be reused here.
TRINITY_QUERY_IMAGE=

TRINITY_PREVIEW_ENABLED=true
# Each JSON object maps its active ID to a NEW, independent 32-byte key,
# encoded as 43 unpadded base64url characters. Persist these across restarts.
TRINITY_PREVIEW_CURSOR_ACTIVE_KEY_ID=ec2-preview-1
TRINITY_PREVIEW_CURSOR_KEYS_JSON=
TRINITY_REFRESH_CURSOR_ACTIVE_KEY_ID=ec2-refresh-1
TRINITY_REFRESH_CURSOR_KEYS_JSON=

# OMIT AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_LOGIN_CACHE_DIRECTORY and TRINITY_S3_ENDPOINT_URL.
# Internal URLs, password-file paths and AWS_CONFIG_FILE are set by Compose.

# Approved public IP HTTPS uses compose.public.yaml as the fifth layer.
# Set the three existing web variables above to the current EC2 public IP,
# 0.0.0.0:80 and 0.0.0.0:443; validate with --public-https.
# Keep the default values for the original private-only configuration.
