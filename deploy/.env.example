# Non-secret web settings only. Load backend secrets separately on the server.
# This mode is private: reach http://localhost:8080 through an SSH tunnel.
TRINITY_SITE_ADDRESS=http://:80
TRINITY_HTTP_BIND=127.0.0.1:8080
TRINITY_HTTPS_BIND=127.0.0.1:8443
TRINITY_RELEASE=local

# For public domain HTTPS, replace the three settings above with:
# TRINITY_SITE_ADDRESS=trinity.example.com
# TRINITY_HTTP_BIND=0.0.0.0:80
# TRINITY_HTTPS_BIND=0.0.0.0:443
