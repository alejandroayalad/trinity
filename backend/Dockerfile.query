# Separate query image: no API entrypoint, migrations, credentials or listeners.
FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM python:3.14.8-slim-bookworm AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON=/usr/local/bin/python3 UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev --no-editable
FROM python:3.14.8-slim-bookworm
RUN groupadd --system --gid 10001 trinity && useradd --system --uid 10001 --gid trinity --no-create-home trinity
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /query
ENTRYPOINT ["/opt/venv/bin/python"]
CMD ["-m", "trinity.queries.runtime"]
