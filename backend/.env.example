# Export this variable into the process environment before using the EIA loader.
# Copying this file alone does not load it. No .env file is read automatically.
# Supply a private EIA key locally; never commit or log it.
EIA_API_KEY=

# Trusted storage routing. These variables do not create or secure a bucket.
# Use an existing private bucket with enforced conditional writes and no delete
# or lifecycle deletion of retained candidates. Real protection needs verification.
TRINITY_S3_BUCKET=
TRINITY_S3_PREFIX=private/candidates
TRINITY_S3_REGION=
# Optional: omit this variable for the AWS endpoint. If set, require HTTPS with
# no user-info, path, query or fragment. Never put credentials in this URL.
# TRINITY_S3_ENDPOINT_URL=https://storage.example.invalid
# Supply credentials through the SDK's trusted provider chain, not this file.

# API and migrations only. Export the real value locally; never commit it.
# Percent-encode reserved characters in the password. .env is not auto-loaded.
TRINITY_DATABASE_URL=postgresql://trinity:REPLACE_LOCALLY@127.0.0.1:15432/trinity
# compose.yaml requires TRINITY_POSTGRES_PASSWORD in the shell environment.
